# Credentials for the content agents in `agents/`. Copy to `.env.local`,
# which is git-ignored, and fill in. See agents/README.md.
#
# Nothing here is read by the app. The PWA is a static export with no backend
# and no key; `agents/shared/config.mjs` is the only reader, and nothing in
# `src/` imports it. Never give any of these a NEXT_PUBLIC_ prefix — that
# prefix compiles a value into the bundle a child downloads.

# Google Gemini, free tier only.
# Create at https://aistudio.google.com/apikey, in a project with NO billing
# account attached: a project that cannot be billed cannot generate a bill.
GEMINI_API_KEY=

# Optional. Free-tier model names change, so this is not pinned in source.
# GEMINI_MODEL=gemini-2.0-flash

# Google Drive, for reading the teacher's curriculum. Not needed when running
# with --source-dir. Scope: https://www.googleapis.com/auth/drive
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Optional. The library root folder's id; found by name when left empty.
# DRIVE_LIBRARY_ROOT_ID=
